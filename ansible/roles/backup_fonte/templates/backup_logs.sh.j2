#!/bin/bash
set -e

# ==========================================
# VARIÁVEIS GERAIS DO AMBIENTE (LOGS)
# ==========================================
NOME_SERVIDOR="{{ nome_servidor }}"
DATA_ONTEM=$(date -d "yesterday" +%Y-%m-%d)
DATA_ONTEM_S3=$(date -d "yesterday" +%Y/%m/%d)
OCI_ENDPOINT="https://gr7swnp1wj0e.compat.objectstorage.sa-saopaulo-1.oraclecloud.com"

echo "[$(date +'%Y-%m-%d %H:%M:%S')] Iniciando rotina de backup EXCLUSIVA DE LOGS (D-1)..."

{% if aplicacoes is defined %}
{% for app in aplicacoes %}
echo "[$(date +'%Y-%m-%d %H:%M:%S')] Processando logs de {{ app.id_bucket }}..."

{% if app.tipo_app == 'rails' %}
LOG_DIR="{{ app.caminho_base | default('/home/ubuntu/AdAlive-Apps') }}/Logs"
LOG_PREFIX=$(echo "{{ app.log_principal }}" | cut -d'.' -f1)

{% elif app.tipo_app == 'quarkus' %}
LOG_DIR="{{ app.caminho_base | default('/u01/microservices') }}/logs"
LOG_PREFIX=$(echo "{{ app.log_principal }}" | cut -d'.' -f1)

{% else %}
LOG_DIR="{{ app.caminho_base | default('/home/ubuntu') }}/{{ app.nome_pasta }}/logs"
LOG_PREFIX=""
{% endif %}

BUCKET_LOGS="s3://backups/aplicacoes/${NOME_SERVIDOR}/{{ app.id_bucket }}/logs/${DATA_ONTEM_S3}/"

if [ -d "${LOG_DIR}" ]; then
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] Verificando logs finalizados do dia ${DATA_ONTEM} em ${LOG_DIR}..."
    
    if [ -n "$LOG_PREFIX" ]; then
        # Busca FILTRADA: Apenas logs desta app Rails/Quarkus específica
        CMD_FIND="find \"${LOG_DIR}\" -maxdepth 1 -type f -name \"*${DATA_ONTEM}*\" -name \"*${LOG_PREFIX}*\" \( -name \"*.gz\" -o -name \"*.log\" -o -name \"*.txt\" \)"
    else
        # Busca PADRÃO: Pega todos os logs do Tomcat
        CMD_FIND="find \"${LOG_DIR}\" -maxdepth 1 -type f -name \"*${DATA_ONTEM}*\" \( -name \"*.gz\" -o -name \"*.log\" -o -name \"*.txt\" \)"
    fi
    
    while IFS= read -r log_file; do
        if [ -f "$log_file" ]; then
            if [[ "$log_file" == *.gz ]]; then
                ARQUIVO_FINAL="$log_file"
            else
                gzip -kf "$log_file" || true
                ARQUIVO_FINAL="${log_file}.gz"
            fi
            
            if [ -f "$ARQUIVO_FINAL" ]; then
                echo "[$(date +'%Y-%m-%d %H:%M:%S')] Enviando log consolidado $(basename "$ARQUIVO_FINAL") para ${BUCKET_LOGS}..."
                aws s3 cp "$ARQUIVO_FINAL" "${BUCKET_LOGS}" \
                    --endpoint-url "${OCI_ENDPOINT}" \
                    --region sa-saopaulo-1
            fi
        fi
    done < <(eval "$CMD_FIND")
fi
echo "---------------------------------------------------------"
{% endfor %}
{% endif %}

# =========================================================
# ROTINA DO SISTEMA OPERACIONAL (Syslog / Auth) E APACHE
# =========================================================
echo "[$(date +'%Y-%m-%d %H:%M:%S')] Processando logs nativos do SO e Apache (D-1)..."

BUCKET_SO="s3://backups/servidores/${NOME_SERVIDOR}/so/logs/${DATA_ONTEM_S3}/"
BUCKET_APACHE="s3://backups/servidores/${NOME_SERVIDOR}/apache/logs/${DATA_ONTEM_S3}/"

enviar_log_padrao_ubuntu() {
    local arquivo_origem="$1"
    local bucket_destino="$2"
    
    if [ -f "${arquivo_origem}" ]; then
        local nome_base=$(basename "${arquivo_origem}" .1)
        local arquivo_final="/tmp/${nome_base}.${DATA_ONTEM}.gz"
        
        echo "[$(date +'%Y-%m-%d %H:%M:%S')] Compactando e enviando ${nome_base} consolidado..."
        gzip -c "${arquivo_origem}" > "${arquivo_final}"
        
        aws s3 cp "${arquivo_final}" "${bucket_destino}" \
            --endpoint-url "${OCI_ENDPOINT}" \
            --region sa-saopaulo-1
            
        rm -f "${arquivo_final}"
    fi
}

enviar_log_padrao_ubuntu "/var/log/auth.log.1" "${BUCKET_SO}"
enviar_log_padrao_ubuntu "/var/log/syslog.1" "${BUCKET_SO}"

if [ -d "/var/log/apache2" ]; then
    for apache_log in /var/log/apache2/*.1; do
        if [ -f "${apache_log}" ]; then
            enviar_log_padrao_ubuntu "${apache_log}" "${BUCKET_APACHE}"
        fi
    done
fi

echo "---------------------------------------------------------"
echo "[$(date +'%Y-%m-%d %H:%M:%S')] Rotina de logs finalizada com sucesso!"