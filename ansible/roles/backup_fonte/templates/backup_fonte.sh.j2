#!/bin/bash

# Aborta o script em caso de qualquer erro
set -e

# ==========================================
# VARIÁVEIS GERAIS DO AMBIENTE
# ==========================================
NOME_SERVIDOR="{{ nome_servidor }}"
DATA_HOJE=$(date +%Y/%m/%d)
DATA_ARQUIVO=$(date +%Y-%m-%d)
OCI_ENDPOINT="https://gr7swnp1wj0e.compat.objectstorage.sa-saopaulo-1.oraclecloud.com"

echo "[$(date +'%Y-%m-%d %H:%M:%S')] Iniciando rotina de backup (Multi-App & Logs)..."

{% if aplicacoes is defined %}
{% for app in aplicacoes %}
# =========================================================
# PROCESSANDO APLICAÇÃO: {{ app.id_bucket }} (Tipo: {{ app.tipo_app }})
# =========================================================
echo "[$(date +'%Y-%m-%d %H:%M:%S')] Processando {{ app.id_bucket }}..."

{% if app.tipo_backup == 'fonte' %}
APP_BASE_DIR="{{ app.caminho_base | default('/home/ubuntu/AdAlive-Apps') }}"
APP_FOLDER="{{ app.nome_pasta }}"
LOCAL_BACKUP_DIR="${APP_BASE_DIR}"
NOME_ARQUIVO="${APP_FOLDER}.${DATA_ARQUIVO}.tar.gz"
CAMINHO_BACKUP="${LOCAL_BACKUP_DIR}/${NOME_ARQUIVO}"
BUCKET_DESTINO="s3://backups/aplicacoes/${NOME_SERVIDOR}/{{ app.id_bucket }}/fonte/${DATA_HOJE}/${NOME_ARQUIVO}"

echo "[$(date +'%Y-%m-%d %H:%M:%S')] Compactando código-fonte de ${APP_FOLDER}..."
tar --exclude='log/*' \
    --exclude='tmp/*' \
    --exclude='node_modules/*' \
    -czf "${CAMINHO_BACKUP}" \
    -C "${APP_BASE_DIR}" "${APP_FOLDER}"

echo "[$(date +'%Y-%m-%d %H:%M:%S')] Realizando upload de ${NOME_ARQUIVO} para ${BUCKET_DESTINO}..."
aws s3 cp "${CAMINHO_BACKUP}" "${BUCKET_DESTINO}" \
    --endpoint-url "${OCI_ENDPOINT}" \
    --region sa-saopaulo-1

echo "[$(date +'%Y-%m-%d %H:%M:%S')] Limpando backups locais antigos de {{ app.id_bucket }}..."
find "${LOCAL_BACKUP_DIR}" -type f -name "{{ app.nome_pasta }}.*.tar.gz" ! -name "${NOME_ARQUIVO}" -delete

{% elif app.tipo_backup == 'war' %}
APP_BASE_DIR="{{ app.caminho_base | default('/home/ubuntu') }}"
APP_FOLDER="{{ app.nome_pasta }}"
LOCAL_BACKUP_DIR="${APP_BASE_DIR}/${APP_FOLDER}/backups"

# Cria a pasta de backup segura caso não exista
mkdir -p "${LOCAL_BACKUP_DIR}"

{% for war in app.arquivos_war %}
WAR_FILE="{{ war }}"
NOME_ARQUIVO="${WAR_FILE}.${DATA_ARQUIVO}.tar.gz"
CAMINHO_BACKUP="${LOCAL_BACKUP_DIR}/${NOME_ARQUIVO}"
BUCKET_DESTINO="s3://backups/aplicacoes/${NOME_SERVIDOR}/{{ app.id_bucket }}/war/${DATA_HOJE}/${NOME_ARQUIVO}"

echo "[$(date +'%Y-%m-%d %H:%M:%S')] Compactando arquivo WAR (${WAR_FILE}) de ${APP_FOLDER}/webapps..."
tar -czf "${CAMINHO_BACKUP}" \
    -C "${APP_BASE_DIR}/${APP_FOLDER}/webapps" "${WAR_FILE}"

echo "[$(date +'%Y-%m-%d %H:%M:%S')] Realizando upload de ${NOME_ARQUIVO} para ${BUCKET_DESTINO}..."
aws s3 cp "${CAMINHO_BACKUP}" "${BUCKET_DESTINO}" \
    --endpoint-url "${OCI_ENDPOINT}" \
    --region sa-saopaulo-1

echo "[$(date +'%Y-%m-%d %H:%M:%S')] Limpando backups locais antigos de ${WAR_FILE}..."
find "${LOCAL_BACKUP_DIR}" -type f -name "${WAR_FILE}.*.tar.gz" ! -name "${NOME_ARQUIVO}" -delete
echo "---"
{% endfor %}
{% endif %}

# =========================================================
# ENVIO DE LOGS ROTACIONADOS DO DIA PARA A OCI
# =========================================================
LOG_DIR="{{ app.caminho_base | default('/home/ubuntu/AdAlive-Apps') }}/{{ app.nome_pasta }}/{% if app.tipo_app == 'rails' %}AdAliveServer{% else %}logs{% endif %}"
BUCKET_LOGS="s3://backups/aplicacoes/${NOME_SERVIDOR}/{{ app.id_bucket }}/logs/${DATA_HOJE}/"

if [ -d "${LOG_DIR}" ]; then
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] Verificando logs rotacionados em ${LOG_DIR}..."
    # Procura arquivos .gz gerados pelo logrotate com a data de hoje ou compactados recentemente
    for log_gz in "${LOG_DIR}"/*.gz; do
        if [ -f "$log_gz" ]; then
            echo "[$(date +'%Y-%m-%d %H:%M:%S')] Enviando log compactado $(basename "$log_gz") para ${BUCKET_LOGS}..."
            aws s3 cp "$log_gz" "${BUCKET_LOGS}" \
                --endpoint-url "${OCI_ENDPOINT}" \
                --region sa-saopaulo-1
        fi
    done
fi

echo "[$(date +'%Y-%m-%d %H:%M:%S')] Processamento de {{ app.id_bucket }} concluído."
echo "---------------------------------------------------------"

{% endfor %}
{% endif %}

echo "[$(date +'%Y-%m-%d %H:%M:%S')] Rotina consolidada finalizada com sucesso!"