#!/bin/bash

# Aborta o script em caso de qualquer erro
set -e

# ==========================================
# VARIÁVEIS DE AMBIENTE E CAMINHOS
# ==========================================
# O Ansible substituirá a variável abaixo pelo nome do servidor (ex: hmg-col-102)
NOME_SERVIDOR="{{ nome_servidor }}"

# Estrutura de datas para nomenclatura e diretórios
DATA_HOJE=$(date +%Y/%m/%d)
DATA_ARQUIVO=$(date +%Y-%m-%d)
NOME_ARQUIVO="fonte_adalive_${DATA_ARQUIVO}.tar.gz"

# Caminhos locais e de destino
APP_BASE_DIR="/home/ubuntu/AdAlive-Apps/AdAlive-doTerrahmlg"
APP_FOLDER="AdAliveServer"
CAMINHO_TMP="/tmp/${NOME_ARQUIVO}"

# Configuração da OCI S3
BUCKET_DESTINO="s3://backups/aplicacoes/${NOME_SERVIDOR}/fonte/${DATA_HOJE}/${NOME_ARQUIVO}"
OCI_ENDPOINT="https://gr7swnp1wj0e.compat.objectstorage.sa-saopaulo-1.oraclecloud.com"

# ==========================================
# EXECUÇÃO DO BACKUP
# ==========================================

echo "[$(date +'%Y-%m-%d %H:%M:%S')] Iniciando backup do codigo fonte..."

# 1. Compactação do Código
# Ignoramos pastas pesadas e temporárias (logs, tmp, node_modules) que não são necessárias no backup do fonte
echo "[$(date +'%Y-%m-%d %H:%M:%S')] Compactando arquivos em ${CAMINHO_TMP}..."
tar --exclude='log/*' \
    --exclude='tmp/*' \
    --exclude='node_modules/*' \
    -czf "${CAMINHO_TMP}" \
    -C "${APP_BASE_DIR}" "${APP_FOLDER}"

# 2. Upload para a Oracle Cloud (OCI)
echo "[$(date +'%Y-%m-%d %H:%M:%S')] Realizando upload para ${BUCKET_DESTINO}..."
aws s3 cp "${CAMINHO_TMP}" "${BUCKET_DESTINO}" --endpoint-url "${OCI_ENDPOINT}"

# 3. Limpeza Local
echo "[$(date +'%Y-%m-%d %H:%M:%S')] Removendo arquivo temporario local..."
rm -f "${CAMINHO_TMP}"

echo "[$(date +'%Y-%m-%d %H:%M:%S')] Backup finalizado com sucesso!"